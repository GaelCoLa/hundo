# Copiá este archivo como .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings -> API Keys). Ambas son públicas por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (sin NEXT_PUBLIC_): nunca llegan al navegador.
# IGDB: dev.twitch.tv/console -> tu app -> Client ID / New Secret
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
